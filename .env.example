# Copy to .env and fill in real values. Never commit .env.

# Nebius Token Factory (Nemotron + Hermes)
NEBIUS_API_KEY=
NEBIUS_API_URL=https://api.tokenfactory.nebius.com/v1/
NEMOTRON_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Fast everyday calls (look edits); falls back to NEMOTRON_MODEL on error
RESTYLER_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Final pick: Nemotron 3 Super; Hermes 4 is the fallback
INSPECTOR_MODEL=nvidia/nemotron-3-super-120b-a12b
HERMES_MODEL=NousResearch/Hermes-4-405B
# Vision judge (any OpenAI-compatible provider; leave URL/KEY empty for Nebius)
JUDGE_MODEL=moonshotai/Kimi-K2.6
JUDGE_BASE_URL=
JUDGE_API_KEY=

# Tavily
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search

# Sketchfab (GLB downloads) — sketchfab.com/settings/password → API Token
SKETCHFAB_API_TOKEN=
# Sketchfab's API terms require downloads to use the END USER's own Sketchfab login.
# 1 = download with the token above (only when YOU are the user, e.g. running locally)
# 0 = public sites: show Sketchfab models in their official viewer + offer an editable alternative
NVERA_SKETCHFAB_DOWNLOAD=0

# Poly Pizza (free low-poly models) — poly.pizza/settings/api
POLY_PIZZA_API_KEY=

# Public deployment protection (empty access code = anyone can search)
NVERA_ACCESS_CODE=
NVERA_SEARCHES_PER_HOUR=10
NVERA_DAILY_BUDGET_USD=0.5
NVERA_DAILY_SEARCHES=30
NEBIUS_BUDGET_USD=25
